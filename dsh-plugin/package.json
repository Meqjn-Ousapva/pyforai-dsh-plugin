{
  "name": "@local/pyforai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: pyforai check and structural editing for Python (wrap, replace-body, move).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "python",
    "ai-coding",
    "ai-agent",
    "comment-anchors",
    "structural-editing",
    "refactoring",
    "code-review"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "bin/*",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
